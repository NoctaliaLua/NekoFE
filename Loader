	--fades out everything below root (frames, texts, strokes, canvas groups, scroll bars)
	local fadeAll=function(root,time)
		local one=function(o)
			if IsA(o,"UIStroke") then
				tween(o,{Transparency=1},time)
			elseif IsA(o,"GuiObject") then
				local goal={}
				if o.BackgroundTransparency<1 then
					goal.BackgroundTransparency=1
				end
				if IsA(o,"TextLabel") or IsA(o,"TextButton") then
					goal.TextTransparency=1
				end
				if IsA(o,"CanvasGroup") then
					goal.GroupTransparency=1
				end
				if IsA(o,"ScrollingFrame") then
					goal.ScrollBarImageTransparency=1
				end
				if next(goal) then
					tween(o,goal,time)
				end
			end
		end
		one(root)
		for _,o in next,root:GetDescendants() do
			one(o)
		end
	end

