	----------------------------------------------------------------------------
	local notifyList=nil
	local notifyOrder=0
	local notify=function(text)
		tspawn(function()
			if not alive then
				return
			end
			if (not notifyList) or (not notifyList.Parent) then
				local gui=newGui(2147483600)
				notifyList=mk("Frame",{Name=rs(),Position=u2(0,12,0,70),Size=u2(0,320,1,-90),BackgroundTransparency=1},gui)
				mk("UIListLayout",{SortOrder=e.SortOrder.LayoutOrder,Padding=UDim.new(0,6)},notifyList)
			end
			notifyOrder=notifyOrder+1
			local item=mk("Frame",{Name=rs(),LayoutOrder=notifyOrder,Size=u2(1,0,0,34),BackgroundColor3=rgb(55,55,55),BackgroundTransparency=1,BorderSizePixel=0},notifyList)
			mk("UICorner",{CornerRadius=UDim.new(0,10)},item)
			local stroke=mk("UIStroke",{Color=rgb(150,150,150),Transparency=1,Thickness=1.5,ApplyStrokeMode=e.ApplyStrokeMode.Border},item)
			local label=mk("TextLabel",{Name=rs(),Position=u2(0,12,0,0),Size=u2(1,-24,1,0),BackgroundTransparency=1,Text=text,Font=e.Font.GothamMedium,TextSize=16,TextColor3=c3(1,1,1),TextTransparency=1,TextXAlignment=e.TextXAlignment.Left},item)
			tween(item,{BackgroundTransparency=0.3},0.2)
			tween(stroke,{Transparency=0.5},0.2)
			tween(label,{TextTransparency=0},0.2)
			twait(3)
			tween(item,{BackgroundTransparency=1},0.3)
			tween(stroke,{Transparency=1},0.3)
			tween(label,{TextTransparency=1},0.3)
