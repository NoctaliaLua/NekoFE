	----------------------------------------------------------------------------
	-- the restricted hats: only the owner and the friends of the owner can reanimate with them
	----------------------------------------------------------------------------
	local friendOk=false
	local isWhitelisted=function()
		if friendOk then
			return true
		end
		if lp.UserId==OWNER_ID then
			friendOk=true
			return true
		end
		for _=1,3 do
			--IsFriendsWith yields and errors when roblox is down
			local ok,res=pcall(function()
				return lp:IsFriendsWith(OWNER_ID)
			end)
			if ok then
				friendOk=(res==true)
				return friendOk
			end
			twait(1)
		end
		return false
	end
	local kickNotWhitelisted=function()
		pcall(function()
			lp:Kick("You're not whitelisted")
		end)
	end
	--is one of the restricted hats worn (cframes is the list of the engine, part.m is the mesh of a worn hat)
	local wearsRestricted=function(cframes)
		for part in next,cframes do
			if part.m and (part.m~="") then
				for _,id in next,RESTRICTED_LIST do
					local info=hatmeshes[id]
					if info and (info.m~="") and sfind(part.m,info.m,1,true) then
						return true
					end
				end
			end
		end
		return false
	end
	----------------------------------------------------------------------------
	-- preload: everything the first reanimate needs (the mesh and texture ids of the pieces (bows, faces, tail)), so it doesnt lag
	----------------------------------------------------------------------------
	local PRE={pending=0}
	local job=function(f)
		PRE.pending=PRE.pending+1
		tspawn(function()
			pcall(f)
			PRE.pending=PRE.pending-1
		end)
	end
	local preloadMode=function(name)
		job(function()
			fetchAll(modeIds(name),30)
		end)
	end

	--the rig hats of a mode (the torso of the noob rig, the torso and limbs of the universal rig): their mesh comes from the asset lookup,
	--so the aligns entries are made right before each reanimate (aligns is the engine's list of hats that get fixed to a body part)
	local rigAligns={}
	local setRigAligns=function()
		for _,a in next,rigAligns do
			local at=tfind(aligns,a)
			if at then
				table.remove(aligns,at)
			end
		end
		tclear(rigAligns)
		for _,r in next,(MODES[modeName].rig or {}) do
			local info=hatmeshes[r.id]
			if info and info.m~="" then
				local a={PartName=r.part,meshid=info.m,textureid=info.t,C0=r.c0}
				tinsert(rigAligns,a)
				tinsert(aligns,1,a)
			end
		end
	end

	----------------------------------------------------------------------------
	-- loading the hats (commands of Just A Baseplate, only -gh)
	----------------------------------------------------------------------------
	local hatsBusy=false
	--returns true if the hats are being loaded
	local loadHats=function(name,text)
		if c then
			notify("Stop the reanimate first")
			return false
		end
		if hatsBusy then
			return false
		end
		--the mode is picked even outside Just A Baseplate (hats worn some other way)
		setMode(name)
		preloadMode(name)
		if game.PlaceId~=JUST_A_BASEPLATE then
			notify("Hats only load in Just A Baseplate")
			return false
		end
		hatsBusy=true
		DATA.stats.hats=DATA.stats.hats+1
		saveData()
		updateStats()
		notify("Loading "..text.." hats")
		tspawn(function()
			local wait=MODES[name].delay or HATS_WAIT
			fireCmd("-ch")
			twait(0.1)
			--10 ids per command
			for _,cmd in next,hatCommands(MODES[name]) do
				fireCmd("-gh "..cmd)
				twait(wait)
			end
			hatsBusy=false
		end)
		return true
	end

	local RT=nil --the state of the current run, nil while not reanimated
	local starting=false
	local stopAll=function()
		local was=(c~=nil) or (RT~=nil)
		local rt=RT
		RT=nil
		if rt and rt.cleanup then
			pcall(rt.cleanup)
		end
		stopreanimate()
		if was and RESPAWN_ON_STOP then
			pcall(function()
				local ch=insGet(lp,"Character")
				local hum=ch and FindFirstChildOfClass(ch,"Humanoid")
				if hum then
					insSet(hum,"Health",0)
				end
			end)
			if game.PlaceId==JUST_A_BASEPLATE then
				tdelay(0.5,function()
					fireCmd("-re")
				end)
			end
		end
	end

	----------------------------------------------------------------------------
	-- pose library: every pose is a table of joint C0s {root,neck,rs,ls,rh,lh}. the C0s are built from "delta" rotations
	-- (what the part does compared to the default standing pose, in torso space), so a pose can be read as plain angles.
	-- (the engine's default C0s for the neck and the root joint are turned by angles(-pi/2,0,pi), the hips and shoulders by 90 degrees on y)
	----------------------------------------------------------------------------
	local rx=function(a) return angles(a,0,0) end
	local ry=function(a) return angles(0,a,0) end
	local rz=function(a) return angles(0,0,a) end
	local RYp=angles(0,pi/2,0)
	local RYn=angles(0,-pi/2,0)
	local ROOT_N=angles(-pi/2,0,pi)
	--shoulder/hip C0 that makes the limb point the way ra says (ra is relative to the torso, identity = hanging down)
	--p is the joint position on the torso
	local limbR=function(p,ra) return cfMul(cfMul(cf(p),ra),RYp) end
	local limbL=function(p,ra) return cfMul(cfMul(cf(p),ra),RYn) end
	--turns something around the point p
	local rotAbout=function(p,r) return cfMul(cfMul(cf(p),r),cf(-p)) end
	local pivotR=v3(1-armIn,0.5,0)
	local pivotL=v3(-1+armIn,0.5,0)
	local hipPR=v3(1,-1,0)
	local hipPL=v3(-1,-1,0)
	--the C1 of the engine's joints (where the joint sits on the arm/leg)
	local C1_RH=cfMul(cf(0.5,1,0),RYp)
	local C1_LH=cfMul(cf(-0.5,1,0),RYn)
	local rootC=function(p,d) return cfMul(cf(p),cfMul(d,ROOT_N)) end --p = where the torso is (relative to the root part), d = how it is turned
	local neckC=function(p,d) return cfMul(cf(p),cfMul(d,ROOT_N)) end --p = v3(0,1,0) plus whatever offset
	--arm rotation from pitch (forward, negative = backwards), out (away from the body, negative = towards it) and twist. side is 1 for the right arm and -1 for the left one
	--the arm is first moved out sideways and then lifted forward, so "out" keeps meaning "away from the body" at any pitch
	local armRot=function(side,pitch,out,twist)
		return cfMul(cfMul(rx(pitch),rz(side*out)),ry(twist or 0))
	end
	local armC=function(side,off,pitch,out,twist)
		if side==1 then
			return limbR(pivotR+off,armRot(1,pitch,out,twist))
		end
		return limbL(pivotL+off,armRot(-1,pitch,out,twist))
	end
	--d = rotation of the leg (identity = hanging down, rx(pi/2) = straight forward)
	local legC=function(side,off,d)
		if side==1 then
			return limbR(hipPR+off,d)
		end
		return limbL(hipPL+off,d)
	end
	local v3_waistT=v3(0,-1,0) --the waist in torso space

	local poses={}

	--idle: slight forward lean, head turned 10 degrees (-10 on y), hands behind the back
	--that dip 0.2 studs and come back up slowly
	poses.idle=function(s,Ychg,rY,lY)
		local bob=sin(s*1.3)
		local lean=rad(5)
		local dip=-0.1*(1-cos(s*1.6))
		return {
			root=rootC(v3(0,0.09+0.1*bob+Ychg,0.025*bob),rx(-lean+0.026*bob)),
			neck=neckC(v3(0,1,0),angles(lean+0.035-0.026*sin((s+1)*1.3),rad(-10),0.052*sin((s-0.6)*0.65))),
			rs=armC(1,v3(0,dip,0),rad(-30),rad(-34),0),
			ls=armC(-1,v3(0,dip,0),rad(-30),rad(-34),0),
			rh=legC(1,v3(0,-0.09-0.1*bob+rY-Ychg,-0.5*rY),cfMul(rx(lean-0.026*bob),ry(rad(-10)))),
			lh=legC(-1,v3(0,-0.09-0.1*bob+lY-Ychg,-0.5*lY),cfMul(rx(lean-0.026*bob),ry(rad(10))))
		}
	end

	--cute sit: legs flat on the ground in front, each turned 30 degrees out, hands between the legs (the arms are moved 0.3 down and 0.3 inwards),
	--torso, arms and head sway left and right
	poses.cuteSit=function(s)
		local off=-1.42
		local lean=rad(14)
		local sway=rad(7)*sin(s*0.9)
		local spread=rad(30)
		local fixLeg=rotAbout(v3_waistT,rz(-sway)) --the legs stay on the ground while the torso sways
		local armSway=rad(3)*sin(s*0.9-0.5)
		return {
			root=cfMul(rotAbout(v3(0,off-1,0),rz(sway)),rootC(v3(0,off,0),rx(-lean))),
			neck=neckC(v3(0,1,0),angles(lean+rad(2)*sin(s*1.8),0,rad(6)*sin(s*0.9+0.6))),
			rs=armC(1,v3(-0.3,-0.3,0),rad(50),rad(-34)+armSway,0),
			ls=armC(-1,v3(0.3,-0.3,0),rad(50),rad(-34)-armSway,0),
			rh=cfMul(fixLeg,legC(1,v3_0,cfMul(ry(-spread),rx(pi/2+lean)))),
			lh=cfMul(fixLeg,legC(-1,v3_0,cfMul(ry(spread),rx(pi/2+lean))))
		}
	end

	--sit hug: sits on its legs (folded back), arms around the front, the head moves 0.3 studs forward and back
	--the torso is 0.4 studs lower than it was, the legs stay where they were (legUp is "up" in torso space, it lifts the hips back by the same amount)
	poses.sitHug=function(s)
		local drop=0.4
		local off=-1.5-drop
		local lean=rad(8)
		local legUp=v3(0,drop*cos(lean),drop*sin(lean))
		local f=0.15*(1-cos(s*1.5)) --0 to 0.3 studs
		local nod=rad(3)*(f/0.3)
		local squeeze=rad(3)*sin(s*1.5)
		return {
			root=rootC(v3(0,off+0.02*sin(s*1.5),0),rx(-lean)),
			neck=neckC(v3(0,1,-f),angles(lean-nod+0.03,0,0)),
			rs=armC(1,v3_0,rad(85),rad(-48)+squeeze,0),
			ls=armC(-1,v3_0,rad(85),rad(-48)+squeeze,0),
			rh=legC(1,legUp,cfMul(ry(rad(30)),rx(-pi/2+lean))),
			lh=legC(-1,legUp,cfMul(ry(rad(-30)),rx(-pi/2+lean)))
		}
	end

	--height of the lowest point of a foot when the torso is bent (used to keep the lowest foot on the ground, the ground is 3 studs below the root part)
	local footY=function(torsoCF,c0,c1,z)
		local part=cfMul(torsoCF,cfMul(c0,Inverse(c1)))
		return v3Get(cfGet(cfMul(part,cf(0,-1,z)),"Position"),"Y")
	end
	--arm that points from its shoulder at a point on the torso (torso space), extraOut = how many more radians it is turned away from the body
	local armAim=function(side,off,tx,ty,tz,extraOut)
		local p=(side==1) and pivotR or pivotL
		local dx=tx-(v3Get(p,"X")+v3Get(off,"X"))
		local dy=ty-(v3Get(p,"Y")+v3Get(off,"Y"))
		local dz=tz-(v3Get(p,"Z")+v3Get(off,"Z"))
		local len=sqrt(dx*dx+dy*dy+dz*dz)
		return armC(side,off,math.atan2(-dz/len,-dy/len),math.asin(side*dx/len)+extraOut,0)
	end

	--bow fix (T): both arms point at the bows, turned 10 degrees outwards, and the hands go around the bows in small circles.
	--the bows follow the circle a little (frame() uses fixBowOffset), bowW fades that in and out
	local FIX_OUT=rad(10)
	local FIX_HAND=0.08 --studs, how far the point the hand aims at moves on its circle (was 0.2, the bow fix is calmer now)
	local FIX_BOW=0.06 --studs, how far the bow moves on its circle (was 0.16)
	--the two sides are not tied together: the right one circles one way at 2.2 rad/s, the left one the other way at a different speed (3 rad/s),
	--so they drift in and out of step and never look like one piece
	local fixPhase=function(side,s)
		if side==1 then
			return s*2.2
		end
		return 1.7-s*3
	end
	local fixBowOffset=function(side,s)
		local a=fixPhase(side,s)
		return v3(FIX_BOW*cos(a),FIX_BOW*sin(a),0)
	end
	--the normal idle body (legs, lean, breathing) with the head looking down at the bows and the arms busy with them. bowL/bowR = where the bows sit
	poses.bowFix=function(s,Ychg,rY,lY,bowL,bowR)
		local p=poses.idle(s,Ychg,rY,lY)
		p.neck=neckC(v3(0,1,0),angles(rad(-12)+0.02*sin(s*1.3),0,0))
		for _,arm in next,{{1,bowR,"rs"},{-1,bowL,"ls"}} do
			local side,bow=arm[1],arm[2]
			local a=fixPhase(side,s)
			p[arm[3]]=armAim(side,v3_0,
				v3Get(bow,"X")+FIX_HAND*cos(a),
				v3Get(bow,"Y")+FIX_HAND*sin(a),
				v3Get(bow,"Z")-0.15,
				FIX_OUT)
		end
		return p
	end

	--exhausted (Y): lying on its back, arms and legs spread out a bit, not moving
	poses.exhausted=function()
		return {
			root=rootC(v3(0,-2.5,0),rx(pi/2)),
			neck=neckC(v3(0,1,0),ry(rad(-20))),
			rs=armC(1,v3_0,0,rad(40),0),
			ls=armC(-1,v3_0,0,rad(40),0),
			rh=legC(1,v3_0,rz(rad(18))),
			lh=legC(-1,v3_0,rz(rad(-18)))
		}
	end

	--tired fall (U): the legs keep standing, the torso is bent forward at the waist until it points 45 degrees below the horizontal (135 degrees from upright),
	--the head lies on the ground on its right cheek looking to the left and the arms lie stretched out forward on the ground next to the head.
	--everything except the torso is worked out in world space and turned into torso space, so the legs, head and arms stay put while the torso breathes
	local TIRED_LEAN=rad(135) --how far the torso is bent forward (90 = horizontal, 135 = 45 degrees towards the ground)
	local TIRED_ARM_OUT=rad(30) --how far the arms are spread apart from the head
	local TIRED_ARM_DOWN=rad(15) --the arms point a bit down so they rest on the ground
	local TIRED_UP=0.25 --the torso sits this much higher...
	local TIRED_BACK=0.25 --...and this much further back than the legs, head and arms
	local tiredArm=function(side,lean)
		local wx=side*sin(TIRED_ARM_OUT)*cos(TIRED_ARM_DOWN)
		local wy=-sin(TIRED_ARM_DOWN)
		local wz=-cos(TIRED_ARM_OUT)*cos(TIRED_ARM_DOWN)
		--the same direction in torso space (the torso is turned by rx(-lean))
		local ty=cos(lean)*wy-sin(lean)*wz
		local tz=sin(lean)*wy+cos(lean)*wz
		return armC(side,v3_0,math.atan2(-tz,-ty),math.asin(side*wx),0)
	end
	poses.tiredFall=function(s)
		local lean=TIRED_LEAN+rad(1.2)*sin(s*1.2)
		local rh=legC(1,v3_0,cfMul(rx(lean),ry(rad(-10))))
		local lh=legC(-1,v3_0,cfMul(rx(lean),ry(rad(10))))
		--the torso bends around the waist, the height is worked out so the lowest foot touches the ground (same as the transitioner)
		local base=cfMul(rotAbout(v3(0,-0.9,0),rx(-lean)),rootC(v3(0,0.09,0),cf_0))
		local torso=cfMul(base,Inverse(ROOT_N))
		local low=min(
			min(footY(torso,rh,C1_RH,0.5),footY(torso,rh,C1_RH,-0.5)),
			min(footY(torso,lh,C1_LH,0.5),footY(torso,lh,C1_LH,-0.5))
		)
		--the torso alone is moved TIRED_UP studs up and TIRED_BACK studs backwards: the joints hang on the torso, so the shift (turned into torso space)
		--is taken out of every joint again and the legs, head and arms stay where they were
		local rot=cfAdd(torso,-cfGet(torso,"Position"))
		local back=cfGet(cfMul(Inverse(rot),cf(0,TIRED_UP,TIRED_BACK)),"Position")
		local keep=cf(-back)
		return {
			root=cfMul(cf(0,-3-low+TIRED_UP,TIRED_BACK),base),
			--the head: top towards the front, face to the left, right ear on the ground (ry(pi/2)*rz(-pi/2) in world space, rx(lean) takes the torso's turn out)
			neck=cfMul(keep,neckC(v3(0,1,0),cfMul(rx(lean),cfMul(ry(pi/2),rz(-pi/2))))),
			rs=cfMul(keep,tiredArm(1,lean)),
			ls=cfMul(keep,tiredArm(-1,lean)),
			rh=cfMul(keep,rh),lh=cfMul(keep,lh)
		}
	end

	--transitioner (L, transitioner mode only): first the hands go to the top of the legs, then the torso bends forward at the waist (the legs keep standing)
	--while the hands slide down the front of the legs until they touch the ground, then the body comes back up. tr = how far the animation is (0 to 1),
	--it only plays once, after that the body is normal and the leg accessories stay under the map until L is pressed again (that is instant)
	local TR_TIME=1.9 --seconds the whole animation takes
	local TR_DOWN0,TR_DOWN1=0.2,0.58 --tr while the hands slide down (before TR_DOWN0 only the arms move to the top of the legs)
	local TR_UP0,TR_UP1=0.66,0.95 --tr while the body comes back up
	local TR_BEND=rad(92) --how far the torso is bent at the lowest point (the arms are 2 studs long, at this angle the hands touch the ground)
	local TR_HAND=1 --how far in front of the waist the hands slide (the front of the legs is at 0.5 and the hand is 1 stud thick)
	local trEase=function(a,b,tr) --0 before a, 1 after b
		local x=clamp((tr-a)/(b-a),0,1)
		return x*x*(3-2*x)
	end
	local trBend=function(tr) --0 standing, 1 bent down
		return trEase(TR_DOWN0,TR_DOWN1,tr)-trEase(TR_UP0,TR_UP1,tr)
	end
	--how far the leg accessories are down: with the hands to the ground, then on under the map while the body comes up
	local trLegDrop=function(tr)
		return LEG_DROP*trEase(TR_DOWN0,TR_DOWN1,tr)+(HIDE_DEPTH-LEG_DROP)*trEase(TR_UP0,TR_UP1,tr)
	end
	--the arm is aimed at the point where its hand has to be (worked out in world space: the shoulder moves on a circle around the waist, the arm is 2 long)
	--and that point is turned into torso space for armAim
	local trArm=function(side,lean)
		local sl,cl=sin(lean),cos(lean)
		local sf,su=1.5*sl,1.5*cl --the shoulder compared to the waist: forward, up
		local ut=su-sqrt(mmax(4-(TR_HAND-sf)*(TR_HAND-sf),0.01)) --how high the hand is (lower than the shoulder by the arm length)
		local yy=TR_HAND*sl+ut*cl --the hand compared to the waist in torso space: up, front
		local q=TR_HAND*cl-ut*sl
		local px=v3Get((side==1) and pivotR or pivotL,"X")
		return armAim(side,v3_0,px,yy-1,-q,0)
	end
	poses.transition=function(s,tr)
		local lean=TR_BEND*trBend(tr)
		local breath=rad(1)*sin(s*1.5)
		local rh=legC(1,v3_0,rx(lean))
		local lh=legC(-1,v3_0,rx(lean))
		--same as the tired fall: the torso bends around the waist, the height is worked out so the lowest foot touches the ground
		local base=cfMul(rotAbout(v3(0,-0.9,0),rx(-lean-breath)),rootC(v3(0,0.09,0),cf_0))
		local torso=cfMul(base,Inverse(ROOT_N))
		local low=min(
			min(footY(torso,rh,C1_RH,0.5),footY(torso,rh,C1_RH,-0.5)),
			min(footY(torso,lh,C1_LH,0.5),footY(torso,lh,C1_LH,-0.5))
		)
		return {
			root=cfMul(cf(0,-3-low,0),base),
			neck=neckC(v3(0,1,0),angles(lean*0.7,0,0)),
			rs=trArm(1,lean),
			ls=trArm(-1,lean),
			rh=rh,lh=lh
		}
	end

	----------------------------------------------------------------------------
	-- original neko (the Original Neko switch): the idle, walk (crawl with the claws), jump, fall, feet kick (R), giggle (T), the click combos and the
	-- attack (Z) of nekov4.lua. everything is only for show, nothing is damaged. that script moved Welds with arm C1 = 0,0.5,0 and leg C1 = 0,1,0,
	-- the joints of the engine have other C1s, so every old C0 is turned into the C0 that puts the limb in the same place.
	-- n is the sine of the old script (it went up by `change` every 1/30 s)
	----------------------------------------------------------------------------
	poses.neko={} --not a local with its helpers in a do block: main is at the 200 locals a function can have
	do
		local nk=poses.neko
		local NECK_N=cfMul(cf(0,1,0),ROOT_N)
		local C1_RS=cfMul(cf(-0.5,0.5,0),RYp)
		local C1_LS=cfMul(cf(0.5,0.5,0),RYn)
		nk.JUMP_POWER=60 --jump power, walk speed and jump power with the claws (F) on
		nk.CLAW_SPEED=22*1.6
		nk.CLAW_JUMP=60*1.6
		nk.HAPPY_TIME=1.4 --seconds T plays before it goes back to normal (the old script played it once)
		local mul=function(a,...)
			for k=1,select("#",...) do
				a=cfMul(a,(select(k,...)))
			end
			return a
		end
		local deg=function(x,y,z) return angles(rad(x),rad(y),rad(z)) end
		local oldArm=function(side,c0)
			return cfMul(cfMul(c0,cf(0,-0.5,0)),(side==1) and C1_RS or C1_LS)
		end
		--rY/up = the same ground and landing corrections the normal idle has
		local oldLeg=function(side,c0,rY,up)
			return cfMul(cf(0,rY-up,-0.5*rY),cfMul(cfMul(c0,cf(0,-1,0)),(side==1) and C1_RH or C1_LH))
		end
		--root and neck are what the old script multiplied with RootCF / NeckCF, the arms and legs are the whole old C0
		nk.pose=function(root,neck,rs,ls,rh,lh,rY,lY,up)
			rY=rY or 0
			lY=lY or 0
			up=up or 0
			return {
				root=cfMul(cf(0,up,0),cfMul(ROOT_N,root)),
				neck=cfMul(NECK_N,neck),
				rs=oldArm(1,rs),
				ls=oldArm(-1,ls),
				rh=oldLeg(1,rh,rY,up),
				lh=oldLeg(-1,lh,lY,up)
			}
		end
		local P=nk.pose

		--a sound only you hear (the old script put them in the body parts)
		nk.sound=function(id,vol,pitch)
			pcall(function()
				local s=i("Sound")
				s.SoundId="rbxassetid://"..id
				s.Volume=vol
				s.PlaybackSpeed=pitch or 1
				s.Parent=FindFirstChildOfClass(game,"SoundService")
				s:Play()
				tdelay(6,function()
					pcall(Destroy,s)
				end)
			end)
		end

		--the notifications of Notify.lua (a black bar slides in from the left, the icon turns around, the older ones move down)
		local notifyGui=nil
		nk.notify=function(text,duration)
			duration=duration or 3
			tspawn(function()
				if not alive then
					return
				end
				if (not notifyGui) or (not notifyGui.Parent) then
					notifyGui=newGui(2147483600)
				end
				for idx,v in next,GetChildren(notifyGui) do
					tween(v,{Position=u2(0,0,0.1,idx*v.AbsoluteSize.Y*1.2)},0.5)
				end
				local msg=mk("Frame",{Name=rs(),BackgroundColor3=c3(0,0,0),BackgroundTransparency=0.3,BorderSizePixel=0,Position=u2(-1,0,0.1,0),Size=u2(0,420,0,70)},notifyGui)
				mk("UIAspectRatioConstraint",{AspectRatio=6},msg)
				mk("TextLabel",{Name=rs(),AnchorPoint=v2(0,0.5),BackgroundTransparency=1,Position=u2(0.2,-8,0.5,0),Size=u2(0.8,0,1,0),Font=e.Font.Gotham,Text=text,TextColor3=c3(1,1,1),TextScaled=true,TextWrapped=true,TextXAlignment=e.TextXAlignment.Left},msg)
				local icon=mk("ImageLabel",{Name=rs(),AnchorPoint=v2(0,0.5),BackgroundTransparency=1,Position=u2(0,8,0.5,0),Size=u2(0.2,-16,1,-16),Image="rbxasset://textures/ui/Emotes/ErrorIcon.png",Rotation=180},msg)
				tween(msg,{Position=u2(0,0,0,msg.AbsolutePosition.Y)},1)
				twait(0.6)
				tween(icon,{Rotation=0},1)
				twait(0.4+duration)
				tween(msg,{Position=u2(-1,0,0,msg.AbsolutePosition.Y)},1,e.EasingStyle.Quad,e.EasingDirection.In)
				twait(1)
				pcall(Destroy,msg)
			end)
		end

		nk.idle=function(n,claws,rY,lY,up)
			local c,s=cos(n/8),sin(n/8)
			if claws then
				return P(
					mul(cf(0,0,-0.1+0.0395*c),deg(10.5-c,0,-5)),
					deg(-6.5-3.5*s,2.5-5.5*cos(n/16),5-6.5*cos(n/15+0.4*cos(n/10))),
					mul(cf(1.45,0.5,0),deg(10+3*s,25,40+4*c)),
					mul(cf(-1.45,0.5,0),deg(10+3*s,-25,-40-4*c)),
					mul(cf(0.5,-0.95-0.04*c,0),deg(20.5-c,0,2.5)),
					mul(cf(-0.5,-0.95-0.04*c,0),deg(1.5-c,20,-2.5)),
					rY,lY,up)
			end
			return P(
				mul(cf(0,0,-0.1+0.0395*c),deg(1.5-c,0,-20)),
				deg(6.5-3.5*s,2.5-5.5*cos(n/16),20-6.5*cos(n/15+0.4*cos(n/10))),
				mul(cf(1.45,0.5,0),deg(3*s,-5,4+4*c)),
				mul(cf(-1.45,0.5,0),deg(3*s,5,-4-4*c)),
				mul(cf(0.5,-0.95-0.04*c,0),deg(1.5-c,0,2.5)),
				mul(cf(-0.5,-0.95-0.04*c,0),deg(1.5-c,20,-2.5)),
				rY,lY,up)
		end
		--fw / rt = how much you walk forward / to the right (-1 to 1)
		nk.walk=function(n,claws,fw,rt,rY,lY,up)
			local c,s=cos(n/8),sin(n/8)
			local c4,s4=cos(n/4),sin(n/4)
			if claws then --on all fours
				local rh2=mul(cf(-rt/7*c,0,fw/7*c),angles(rad(fw*89)*c,rad(-rt*55/2*c),rad(rt*55*c)))
				local lh2=mul(cf(rt/7*s,0,-fw/7*c),angles(rad(fw*89)*c,rad(rt*55/2*s),rad(-rt*55*s)))
				return P(
					mul(cf(rt*s,fw*s,-0.5-0.255*c-s/8),deg(85+fw*c*20,-rt*c4,-rt*c*10)),
					mul(cf(0,0,0.025*c4),deg(-20+(-fw+fw*c4)*5,(rt*2-rt*c4)*3.5,-rt*45-8*c)),
					mul(cf(1,0.5-fw*0.5*s,-0.4),deg(95-fw*75*s,0,-8-rt*55*s+10*c)),
					mul(cf(-1,0.5-fw*0.5*s,-0.4),deg(95-fw*75*s,0,8+rt*55*c-10*c)),
					mul(cf(0.5,-0.85-0.25*s,-0.15-0.25*s),rh2,deg(60-5*c,0,-2.5)),
					mul(cf(-0.5,-0.85-0.25*s,-0.15-0.25*s),lh2,deg(60-5*s,0,2.5)),
					rY,lY,up)
			end
			local rh2=mul(cf(-rt/7*c,0,fw/7*c),deg(-fw*30*c,0,-rt*30*c))
			local lh2=mul(cf(rt/7*c,0,-fw/7*c),deg(fw*30*c,0,rt*30*c))
			return P(
				mul(cf(0,0,-0.05+0.055*c4-s4/8),deg((fw*2-fw*c4)*7,(-rt*2+rt*c4)*5,8*c)),
				mul(cf(0,0,0.025*c4),deg((-fw+fw*c4)*7,(rt*2-rt*c4)*3.5,-rt*45-8*c)),
				mul(cf(1.45,0.5+rt/50*c,0),deg(fw*15*c,0,8+rt*5*c)),
				mul(cf(-1.45,0.5+rt/50*c,0),deg(-fw*15*c,0,-8-rt*5*c)),
				mul(cf(0.5,-0.85+0.15*s,-0.15+0.15*c),rh2,deg(-5*c,0,2.5)),
				mul(cf(-0.5,-0.85-0.15*s,-0.15-0.15*c),lh2,deg(5*c,0,-2.5)),
				rY,lY,up)
		end
		nk.jump=function(n,fw,rt)
			local c=cos(n/8)
			local air=min(sqrt(fw*fw+rt*rt),1)/25 --how much the speed leans the body in the air (the old inairvel)
			return P(
				mul(cf(0,0.01975*c,-0.1+0.0395*c),angles(rad(-6.5-1.5*c)+air*fw/2,-air*rt/2,0)),
				deg(-26.5+2.5*c,0,0),
				mul(cf(1.45,0.5,0),deg(140-2*c,-5,8+4*c)),
				mul(cf(-1.45,0.5,0),deg(140-2*c,5,-8-4*c)),
				mul(cf(0.5,-0.85+0.05*cos(n/15),-0.2),deg(-15-cos(n/10),0,0)),
				mul(cf(-0.5,-0.35+0.05*cos(n/15),-0.4),deg(-25+cos(n/10),0,0)))
		end
		nk.fall=function(n,fw,rt)
			local c=cos(n/8)
			local air=min(sqrt(fw*fw+rt*rt),1)/25
			return P(
				mul(cf(0,0.01975*c,-0.5+0.0395*c),angles(rad(5.5-1.5*c)-air*fw/2,air*rt/2,0)),
				deg(26.5+2.5*c,0,0),
				mul(cf(1.45,0.5,0),deg(105-2*c,-15,80+4*c)),
				mul(cf(-1.45,0.5,0),deg(105-2*c,15,-80-4*c)),
				mul(cf(0.5,-0.15+0.05*cos(n/15),-0.4),deg(-15-cos(n/10),0,0)),
				mul(cf(-0.5,-0.55+0.05*cos(n/15),-0.4),deg(cos(n/10),0,0)))
		end
		--R: the feet kick, lying on the belly and kicking
		nk.lay=function(n)
			local c=cos(n/8)
			return P(
				mul(cf(0,0,-2.2),deg(75,5*c,5*c)),
				deg(-40,15*sin(n/8),0),
				mul(cf(1,0.5,-0.4),deg(160,5*c,-50+5*c)),
				mul(cf(-1,0.5,-0.4),deg(160,5*c,40+5*c)),
				mul(cf(0.5,-0.9-0.1*c,-0.4+0.4*c),deg(-50+35*c,5*c,-15*c)),
				mul(cf(-0.5,-0.9+0.1*c,-0.4-0.4*c),deg(-50-35*c,5*c,-15*c)))
		end
		--T: the giggle, head tilted and the right arm up
		nk.happy=function(n)
			local c=cos(n/8)
			return P(
				mul(cf(0,0,-0.1-0.05*c),deg(1+c,0,30+c)),
				deg(0,0,-30+c),
				mul(cf(1.3,0.5,0),deg(120,0,-40)),
				cf(-1.5,0.5,0),
				mul(cf(0.5,-0.95+0.05*c,-0.2+0.05*c),deg(-10+c,25*cos(n/16),0)),
				mul(cf(-0.5,-0.95+0.05*c,0),deg(1+c,0,0)))
		end

		--the click combo: 1 to 3 without the claws, 4 to 7 with them. a segment is held for dur seconds (pose can also be a function of how far the segment is, 0 to 1),
		--k = how fast the joints follow it. snds = {at (seconds), id, vol, pitch (a number or a function)}
		local seg=function(dur,pose,k)
			return {dur=dur,pose=pose,k=k or 4}
		end
		local R1,L1=cf(1.5,0.5,0),cf(-1.5,0.5,0)
		local ATTACKS={
			{
				segs={
					seg(0.2,P(deg(20,0,-40),deg(0,0,40),mul(R1,deg(30,0,0)),mul(L1,deg(30,0,0)),mul(cf(0.5,-0.6,-0.4),deg(-20,0,0)),mul(cf(-0.5,-1,0),deg(20,0,20)))),
					seg(0.2,P(mul(cf(0,-1,0),deg(-40,0,40)),deg(0,0,-40),mul(R1,deg(-30,0,0)),mul(L1,deg(-30,0,0)),mul(cf(0.5,-1,0),deg(120,0,0)),mul(cf(-0.5,-1,0),deg(-60,0,-20))))
				}
			},
			{
				segs={
					seg(0.2,P(deg(-20,0,60),deg(0,0,-60),R1,mul(L1,deg(90,0,0)),mul(cf(0.5,-0.5,-0.4),deg(-20,0,0)),mul(cf(-0.5,-1,0),deg(-20,0,0)))),
					seg(0.2,P(mul(cf(0,-1,0),deg(0,0,-70)),deg(0,0,70),R1,mul(L1,deg(0,-20,-90)),mul(cf(0.5,-1,0),deg(20,0,0)),mul(cf(-0.5,-1,0),deg(-20,0,0))))
				}
			},
			{
				segs={
					seg(0.2,P(deg(-20,0,120),deg(0,0,-80),mul(R1,deg(90,0,20)),mul(L1,deg(20,0,0)),mul(cf(0.5,-1,0),deg(-20,0,0)),mul(cf(-0.5,-0.8,0),deg(20,0,0)))),
					seg(0.2,P(mul(cf(0,-1,0),deg(20,0,0)),cf_0,mul(R1,deg(0,0,90)),mul(L1,deg(20,0,0)),mul(cf(0.5,-1,0),deg(-40,0,0)),cf(-0.5,-1,0)))
				}
			},
			{
				snds={{at=0,id="3051417237",vol=3,pitch=function() return mrandom(100,155)/100 end}},
				segs={
					seg(0.2,P(deg(-20,0,-80),deg(20,0,80),R1,mul(L1,deg(-20,-70,-90)),mul(cf(0.5,-1,0),deg(20,0,0)),mul(cf(-0.5,-0.5,-0.4),deg(20,0,0)))),
					seg(0.2,P(mul(cf(0,-1,0),deg(20,0,45)),deg(-20,0,-45),R1,mul(L1,deg(0,0,-90)),mul(cf(0.5,-1,0),deg(20,0,0)),mul(cf(-0.5,-1,0),deg(-10,0,0))))
				}
			},
			{
				snds={{at=0,id="3051417237",vol=3,pitch=function() return mrandom(100,155)/80 end}},
				segs={
					seg(0.2,P(deg(-20,0,80),deg(20,0,-80),mul(R1,deg(-20,70,90)),mul(L1,deg(0,0,-90)),mul(cf(0.5,-0.5,-0.4),deg(20,0,0)),mul(cf(-0.5,-1,0),deg(20,0,0)))),
					seg(0.2,P(mul(cf(0,-1,0),deg(20,0,-45)),deg(-20,0,45),mul(R1,deg(0,0,90)),L1,mul(cf(0.5,-1,0),deg(-10,0,0)),mul(cf(-0.5,-1,0),deg(20,0,0))))
				}
			},
			{
				snds={{at=0,id="3051417237",vol=3,pitch=function() return mrandom(140,185)/80 end}},
				segs={
					seg(0.175,P(mul(cf(0,-1,-0.3),deg(45,0,0)),deg(-20,0,0),mul(cf(1.1,0.5,-0.3),deg(20,115,90)),mul(cf(-1.1,0.5,-0.3),deg(20,-115,-90)),mul(cf(0.5,-1,0),deg(-60,0,0)),mul(cf(-0.5,-1,0),deg(60,0,0))),5),
					seg(0.2,P(mul(cf(0,-1.7,-0.4),deg(45,0,0)),cf_0,mul(R1,deg(0,0,90)),mul(L1,deg(0,0,-90)),cf(0.5,-1,0),mul(cf(-0.5,-1,0),deg(65,0,0))))
				}
			},
			{
				snds={{at=0,id="3051417237",vol=3,pitch=0.8},{at=0.1,id="3051417087",vol=3,pitch=function() return mrandom(100,155)/100 end},{at=0.2,id="3051417087",vol=3,pitch=function() return mrandom(100,155)/100 end}},
				segs={
					seg(10/30,function(f)
						local i=1+9*f --the old loop went from 1 to 10
						return P(mul(cf(0,-1.7+0.17*i,-0.4),deg(25-5*i,0,36*i)),cf_0,mul(R1,deg(180,0,90)),mul(L1,deg(0,0,-90)),mul(cf(0.5,-1,0),deg(-25,0,0)),mul(cf(-0.5,-1,0),deg(25,0,0)))
					end,5)
				}
			}
		}
		--returns a function of the seconds since the attack began: the pose and k, nil when it is over
		nk.attack=function(n)
			local atk=ATTACKS[n]
			local total=0
			for _,s in next,atk.segs do
				total=total+s.dur
			end
			local fired={}
			return function(el)
				if el>=total then
					return nil
				end
				for k,sn in next,(atk.snds or {}) do
					if (not fired[k]) and el>=sn.at then
						fired[k]=true
						local pitch=sn.pitch
						nk.sound(sn.id,sn.vol,(type(pitch)=="function") and pitch() or pitch)
					end
				end
				local at=0
				for _,s in next,atk.segs do
					if el<at+s.dur then
						local pose=s.pose
						if type(pose)=="function" then
							pose=pose((el-at)/s.dur)
						end
						return pose,s.k
					end
					at=at+s.dur
				end
				return nil
			end
		end

		--Z: first the wind up, if somebody is standing in front of you (checked by the script, 0.2 to 0.7 s) the whole move plays,
		--otherwise it ends after 0.7 s. nobody is grabbed or damaged
		nk.Z_CHECK0,nk.Z_CHECK1=0.2,0.7
		nk.zWind=P(deg(20,0,-20),deg(0,0,20),mul(R1,deg(-10,0,20)),mul(L1,deg(0,0,-20)),mul(cf(0.5,-1,0),deg(-20,0,0)),mul(cf(-0.5,-1,0),deg(20,0,0)))
		local Z_SPIN,Z_HANG,Z_DIVE,Z_SLAM,Z_REC=0.77,0.1,0.23,0.3,0.23
		local zHang=P(deg(-65,0,0),deg(65,0,0),mul(R1,deg(90,0,90)),mul(L1,deg(90,0,-90)),mul(cf(0.5,-0.7,-0.2),deg(-40,0,0)),mul(cf(-0.5,-1,0),deg(-30,0,0)))
		local zSlam=P(mul(cf(0,0,-0.5),deg(85,0,0)),deg(-65,0,0),mul(R1,deg(130,0,0)),mul(L1,deg(130,0,0)),mul(cf(0.5,-1,0),deg(-25,0,0)),mul(cf(-0.5,-1,0),deg(-25,0,0)))
		local zRec=P(cf_0,deg(35,0,0),mul(R1,deg(30,0,30)),mul(L1,deg(30,0,-30)),mul(cf(0.5,-1,0),deg(10,0,0)),mul(cf(-0.5,-1,0),deg(-10,0,0)))
		--el = seconds since the target was found, returns the pose and k, nil when it is over
		nk.zHit=function(el)
			if el<Z_SPIN then
				local i=1+8.8*el/Z_SPIN --the old loop went from 1 to 10
				return P(
					mul(cf(-0.5*sin(i),0.5*cos(i),0),deg(25-4.5*i,0,72*i)),
					deg(20,0,-80),
					mul(cf(1.5,0.65,0),deg(160+2*i,0,30-3*i)),
					L1,
					mul(cf(0.5,-1,0),deg(6.5*i,0,0)),
					mul(cf(-0.5,-1,0),deg(-6.5*i,0,0))),3
			end
			el=el-Z_SPIN
			if el<Z_HANG then
				return zHang,3
			end
			el=el-Z_HANG
			if el<Z_DIVE then
				local i=1+1.35*el/Z_DIVE
				return P(
					mul(cf(0,2-0.75*i,20-1.8*i),deg(15+60*i,0,0)),
					deg(-25,0,0),
					mul(R1,deg(170,0,90-45*i)),
					mul(L1,deg(170,0,-90+45*i)),
					mul(cf(0.5,-1,0),deg(40,0,0)),
					mul(cf(-0.5,-1,0),deg(40,0,0))),3
			end
			el=el-Z_DIVE
			if el<Z_SLAM then
				return zSlam,3
			end
			el=el-Z_SLAM
			if el<Z_REC then
				return zRec,3
			end
			return nil
		end
	end

	----------------------------------------------------------------------------
	-- reanimate
	----------------------------------------------------------------------------
	local startReanimate=function()
		if c or starting or RT then
			return
		end
		starting=true
		local fine,err=pcall(function()
			--the restricted hats (bows, universal rig) are for the friends of the owner only
			if isRestrictedMode(modeName) and not isWhitelisted() then
				kickNotWhitelisted()
				return
			end
			preloadMode(modeName) --nothing to do if the lookups are done
			if DATA.autoPd then
				tspawn(fireCmd,"-pd")
				twait(0.3)
			end
			if PRE.pending>0 then
				local waited=0
				while (PRE.pending>0) and (waited<40) do
					twait(0.1)
					waited=waited+0.1
				end
			end
			setRigAligns()

			local t=reanimate()
			if type(t)~="table" then
				return
			end

			local cframes=t.cframes
			--a restricted hat that is worn without the mode (loaded by hand) counts as well
			if wearsRestricted(cframes) and not isWhitelisted() then
				kickNotWhitelisted()
				return
			end
			local getPartJoint=t.getPartJoint
			local addmode=t.addmode
			local raycastlegs=t.raycastlegs
			local velbycfrvec=t.velbycfrvec
			local velYchg=t.velYchg
			local setWalkSpeed=t.setWalkSpeed

			local RootJoint=t.getJoint("RootJoint")
			local RightShoulder=t.getJoint("Right Shoulder")
			local LeftShoulder=t.getJoint("Left Shoulder")
			local RightHip=t.getJoint("Right Hip")
			local LeftHip=t.getJoint("Left Hip")
			local Neck=t.getJoint("Neck")

