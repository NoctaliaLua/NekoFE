	}
	local canFile=(type(isfolder)=="function") and (type(makefolder)=="function") and (type(isfile)=="function")
		and (type(readfile)=="function") and (type(writefile)=="function")
	local SETTINGS_FILE=FOLDER.."/Settings.json"
	local loadData=function()
		if not canFile then
			return
		end
		pcall(function()
			if not isfolder(FOLDER) then
				makefolder(FOLDER)
			end
			if isfile(SETTINGS_FILE) then
				local saved=HttpService:JSONDecode(readfile(SETTINGS_FILE))
				if type(saved)=="table" then
					DATA.autoPd=(saved.autoPd==true)
					DATA.originalNeko=(saved.originalNeko==true)
					if type(saved.topbar)=="table" and tonumber(saved.topbar.x) and tonumber(saved.topbar.y) then
						DATA.topbar={x=tonumber(saved.topbar.x),y=tonumber(saved.topbar.y)}
					end
					if type(saved.binds)=="table" then
						for k,v in next,saved.binds do
							if type(v)=="string" then
								DATA.binds[k]=v
							end
						end
					end
					if type(saved.stats)=="table" then
						for _,k in next,{"reanimations","hats","usage"} do
							local n=tonumber(saved.stats[k])
							if n then
								DATA.stats[k]=n
							end
						end
					end
				end
			end
		end)
	end
	local saveData=function()
		if not canFile then
			return
		end
		pcall(function()
			if not isfolder(FOLDER) then
				makefolder(FOLDER)
			end
			writefile(SETTINGS_FILE,HttpService:JSONEncode(DATA))
		end)
	end
