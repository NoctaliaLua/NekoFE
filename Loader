		end
	end)

	local plural=function(n,word)
		return n.." "..word..((n==1) and "" or "s")
	end
	local usageText=function()
		local minutes=math.floor(usageNow()/60)
		if minutes<60 then
			return plural(minutes,"Minute")
		end
		local hours=math.floor(minutes/60)
		if hours<24 then
			return plural(hours,"Hour")
		end
		return plural(math.floor(hours/24),"Day")
	end
	local statsText=function()
		return "Reanimations: "..math.floor(DATA.stats.reanimations).."\nHats Loaded: "..math.floor(DATA.stats.hats).."\nUsage: "..usageText()
	end
	local updateStats=function()
		if menu and menu.stats then
			menu.stats.Text=statsText()
		end
	end

