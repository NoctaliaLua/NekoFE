		local gen=0
		M.setPanel=function(name)
			gen=gen+1
			local target=nil
			if name and name~=current then
				target=name
			end
			current=target
			local g=gen
			for pname,panel in next,panels do
				if pname==target then
					panel.Visible=true
					if pname=="hats" then
						--every button fades in and slides in from the left, one per 0.05s, the transitioner column starts after the normal one is done
						local startAt={0,0.5}
						for _,label in next,hatLabels do
							label.TextTransparency=1
						end
						for _,info in next,hatBtns do
							local b,stroke=info.b,info.stroke
							b.Position=u2(0.5,info.x-70,0.5,info.y)
							b.BackgroundTransparency=1
							b.TextTransparency=1
							stroke.Transparency=1
							tdelay(startAt[info.col]+(info.idx-1)*0.05,function()
								if gen~=g then --closed or switched in the meantime
									return
								end
								if info.idx==1 then
									tween(hatLabels[info.col],{TextTransparency=0},0.3)
								end
								tween(b,{Position=u2(0.5,info.x,0.5,info.y),BackgroundTransparency=0.7,TextTransparency=0},0.45,e.EasingStyle.Quint,e.EasingDirection.Out)
								tween(stroke,{Transparency=0.7},0.45,e.EasingStyle.Quint,e.EasingDirection.Out)
							end)
						end
					else
						panel.GroupTransparency=1
						tween(panel,{GroupTransparency=0},0.25)
					end
				elseif panel.Visible then
					if pname=="hats" then --a plain frame, so everything in it fades by itself
						for _,info in next,hatBtns do
							tween(info.b,{BackgroundTransparency=1,TextTransparency=1},0.2)
							tween(info.stroke,{Transparency=1},0.2)
						end
						for _,label in next,hatLabels do
							tween(label,{TextTransparency=1},0.2)
						end
					else
						tween(panel,{GroupTransparency=1},0.2)
					end
					tdelay(0.25,function()
						if current~=pname then
							panel.Visible=false
						end
					end)
				end
			end
		end

		--the four main buttons, they move in from the left side one after another
		local reanimateStroke=nil
		local mainButtons={"Play","Hats","Keybinds","Reanimate"}
		for k,text in next,mainButtons do
			local y=MENU_Y+(k-1)*(BTN_H+BTN_GAP)
			local b,stroke=makeButton(group,text,-BTN_W-60,y)
			tinsert(M.buttons,{b=b,x=MENU_X,y=y})
			if text=="Reanimate" then
				reanimateStroke=stroke
			end
			b.MouseButton1Click:Connect(function()
				if text=="Play" then
					tspawn(M.close)
				elseif text=="Hats" then
					M.setPanel("hats")
				elseif text=="Keybinds" then
					M.setPanel("keys")
				else
					toggleReanimate()
				end
			end)
		end

		M.intro=function()
			tween(M.title,{TextTransparency=0},0.6)
			tween(M.sub,{TextTransparency=0},0.6)
			for k,info in next,M.buttons do
				tdelay((k-1)*0.1,function()
					tween(info.b,{Position=u2(0,info.x,1,info.y)},0.7,e.EasingStyle.Quint,e.EasingDirection.Out)
				end)
			end
			M.music=startMusic()
			barsFrame.Visible=true
			M.barsOn=true
		end

		--camera
		local sinkName=rs()
		M.startCamera=function()
			local cam=insGet(ws,"CurrentCamera")
			if not cam then
				return
			end
			if c then --the reanimate owns the camera type, only its cframe is taken over (menuCamCF)
				M.engineCam=true
			else
				M.engineCam=false
				M.prevType=insGet(cam,"CameraType")
				if M.prevType==camType.Scriptable then
					M.prevType=camType.Custom
				end
				insSet(cam,"CameraType",camType.Scriptable)
			end
			M.map=getMapInfo()
			M.orbitT=0
			local startCF=orbitCF(M.map,0)
			if c then
				menuCamCF=startCF
			end
			insSet(cam,"CFrame",startCF)
			M.camMode="orbit"
			M.blur=mk("BlurEffect",{Name=rs(),Size=0},LIGHTING)
			tween(M.blur,{Size=22},0.4)
			--the character doesnt walk around while the menu is open
			pcall(function()
				local KC=e.KeyCode
				CAS:BindActionAtPriority(sinkName,function()
					return e.ContextActionResult.Sink
				end,false,3000,KC.W,KC.A,KC.S,KC.D,KC.Space,KC.Up,KC.Down,KC.Left,KC.Right)
			end)
		end
		--puts the normal camera back right away (returns true if the menu camera was running)
		M.snapCamera=function()
			if M.camMode~="orbit" then
				return false
			end
			M.camMode="none"
			pcall(function()
				CAS:UnbindAction(sinkName)
			end)
			local cam=insGet(ws,"CurrentCamera")
			if cam then
				local target=playerCF()
				if target then
					insSet(cam,"CFrame",target)
				end
				insSet(cam,"CameraType",M.prevType or camType.Custom)
			end
			if M.blur then
				local blur=M.blur
				M.blur=nil
				tween(blur,{Size=0},0.4)
				tdelay(0.5,function()
					pcall(Destroy,blur)
				end)
			end
			return true
		end
		M.releaseCamera=function(instant)
			pcall(function()
				CAS:UnbindAction(sinkName)
			end)
			if M.blur then
				local blur=M.blur
				M.blur=nil
				if instant then
					pcall(Destroy,blur)
				else
					tween(blur,{Size=0},0.4)
					tdelay(0.5,function()
						pcall(Destroy,blur)
					end)
				end
			end
			menuCamCF=nil
			if M.camMode~="none" then
				local cam=insGet(ws,"CurrentCamera")
				if cam and (not c) and (not M.engineCam) then
					insSet(cam,"CameraType",M.prevType or camType.Custom)
				end
				M.camMode="none"
			end
		end

		M.conn=Connect(renderstepped,function(dt)
			M.clock=M.clock+dt
			local cam=insGet(ws,"CurrentCamera")
			if M.camMode=="orbit" then
				if cam then
					M.orbitT=M.orbitT+dt
					local cf=orbitCF(M.map,M.orbitT)
					if c then
						M.engineCam=true
						menuCamCF=cf
					elseif M.engineCam then --the reanimate was stopped, the menu camera has the camera again
						M.engineCam=false
						menuCamCF=nil
						M.prevType=camType.Custom
						insSet(cam,"CameraType",camType.Scriptable)
					end
					insSet(cam,"CFrame",cf)
				end
			elseif M.camMode=="return" then
				local a=clamp((osclock()-M.retT0)/1.6,0,1)
				local target=camTarget()
				if cam and target then
					local cf=Lerp(M.retFrom,target,smooth(a))
					if c then
						menuCamCF=cf
					end
					insSet(cam,"CFrame",cf)
				end
				if a>=1 then
					M.camMode="returned"
				end
			end
			if M.barsOn and M.music then
				local levels=M.music.levels(dt,M.clock)
				for k=1,BAR_COUNT do
					bars[k].Size=u2(1/BAR_COUNT,-4,0,4+levels[k]*BAR_MAX)
				end
			end
			--the stroke of the Reanimate button is pink while it is on
			local on=(c~=nil) and true or false
			if reanimateStroke and (M.reOn~=on) then
				M.reOn=on
				tween(reanimateStroke,{Color=on and PINK or rgb(150,150,150)},0.2)
			end
			if osclock()>(M.nextStats or 0) then
				M.nextStats=osclock()+2
				M.stats.Text=statsText()
			end
		end)

		--Play: everything fades out and the camera goes back to the player
		M.close=function()
			if (not MENU_STATE.open) or MENU_STATE.busy then
				return
			end
			MENU_STATE.busy=true
			if capture then
				capture.btn.Text=bindText(capture.cmd.id)
				capture=nil
			end
			M.setPanel(nil)
			fadeAll(group,0.5)
			if M.music then
				M.music.stop()
			end
			local cam=insGet(ws,"CurrentCamera")
			if M.camMode=="orbit" and cam then
				M.retFrom=insGet(cam,"CFrame")
				M.retT0=osclock()
				M.camMode="return"
				if M.blur then
					tween(M.blur,{Size=0},1.4)
				end
				local limit=osclock()+3
				while M.camMode=="return" and osclock()<limit do
					twait()
				end
			else
				twait(0.5)
			end
			M.kill()
			menu=nil
			menuUnlock=false
			MENU_STATE.open=false
			MENU_STATE.busy=false
		end
		--removes everything (also used by the unload)
		M.kill=function()
			pcall(Disconnect,M.conn)
			menuUnlock=false
			if M.music then
				M.music.kill()
			end
			M.releaseCamera(true)
			pcall(Destroy,gui)
		end
		return M
	end

	--black screen -> (while it is black the camera and the menu are set up) -> black screen fades out -> the buttons move in
	openMenu=function(first)
		if MENU_STATE.open or MENU_STATE.busy or not alive then
			return
		end
		MENU_STATE.busy=true
		local blackGui=newGui(2147483647)
		local black=mk("Frame",{Name=rs(),Size=u2(1,0,1,0),BackgroundColor3=c3(0,0,0),BackgroundTransparency=1,BorderSizePixel=0},blackGui)
		tween(black,{BackgroundTransparency=0},0.35,e.EasingStyle.Linear)
		twait(0.4)
		if not alive then
			return
		end
		menu=buildMenu()
		menu.startCamera()
		twait(0.1)
		tween(black,{BackgroundTransparency=1},0.5,e.EasingStyle.Linear)
		twait(0.5)
		pcall(Destroy,blackGui)
		if not alive then
			return
		end
		--the menu is usable even if something in the intro (the music) fails
		menuUnlock=true
		MENU_STATE.open=true
		MENU_STATE.busy=false
		pcall(menu.intro)
		if first then
			--the warning for accounts with less than 600 minutes
			local limit=osclock()+12
			while (not minutesDone) and (osclock()<limit) do
				twait(0.2)
			end
			if minutesLow and alive then
				local gui=newGui(2147483550)
				local box=mk("Frame",{Name=rs(),AnchorPoint=v2(0.5,0.5),Position=u2(0.5,0,0.5,0),Size=u2(0,520,0,90),BackgroundColor3=rgb(40,40,40),BackgroundTransparency=1,BorderSizePixel=0},gui)
				mk("UICorner",{CornerRadius=UDim.new(0,14)},box)
				local stroke=mk("UIStroke",{Color=rgb(255,190,80),Transparency=1,Thickness=2,ApplyStrokeMode=e.ApplyStrokeMode.Border},box)
				local label=mk("TextLabel",{Name=rs(),Position=u2(0,16,0,0),Size=u2(1,-32,1,0),BackgroundTransparency=1,Text="Warning, You have less than 600 Minutes. The script will most likely fail to load.",Font=e.Font.GothamMedium,TextSize=20,TextColor3=rgb(255,210,120),TextTransparency=1,TextWrapped=true},box)
				tween(box,{BackgroundTransparency=0.2},0.3)
				tween(stroke,{Transparency=0.2},0.3)
				tween(label,{TextTransparency=0},0.3)
				twait(8)
				tween(box,{BackgroundTransparency=1},0.4)
				tween(stroke,{Transparency=1},0.4)
				tween(label,{TextTransparency=1},0.4)
				twait(0.5)
				pcall(Destroy,gui)
			end
		end
	end

	----------------------------------------------------------------------------
	-- the N button next to the Roblox buttons in the top bar, opens the menu again
	-- (roblox has no api for icons in the top bar, GuiService.TopbarInset is the free space right of the roblox buttons)
	----------------------------------------------------------------------------
	local topbarGui=newGui(2147483000)
	local topbarBtn=mk("TextButton",{
		Name=rs(),Size=u2(0,44,0,44),BackgroundColor3=rgb(6,6,8),BackgroundTransparency=0.1,BorderSizePixel=0,AutoButtonColor=false,
		Text="N",Font=e.Font.GothamBold,TextSize=20,TextColor3=c3(1,1,1)
	},topbarGui)
	mk("UICorner",{CornerRadius=UDim.new(1,0)},topbarBtn)
	local placeTopbarBtn=function()
		if DATA.topbar then --dragged there before
			topbarBtn.Position=u2(0,DATA.topbar.x,0,DATA.topbar.y)
			return
		end
		local inset=insGet(gs,"TopbarInset")
		local height=inset.Height
		if height<=0 then
			height=58
		end
		topbarBtn.Position=u2(0,inset.Min.X+116,0,(height-44)/2)
	end
	placeTopbarBtn()
	local topbarCon=Connect(GetPropertyChangedSignal(gs,"TopbarInset"),placeTopbarBtn)
	--drag the button around (a drag smaller than 5 pixels is a click), the place is saved
	local dragging,moved,dragStart,startX,startY=false,false,nil,0,0
	local isPointer=function(inp)
		local t=insGet(inp,"UserInputType")
		return t==e.UserInputType.MouseButton1 or t==e.UserInputType.Touch
	end
	topbarBtn.InputBegan:Connect(function(inp)
		if isPointer(inp) then
			dragging=true
			moved=false
			dragStart=inp.Position
			startX=topbarBtn.Position.X.Offset
			startY=topbarBtn.Position.Y.Offset
		end
	end)
	local dragCon=Connect(insGet(uis,"InputChanged"),function(inp)
		if not dragging then
			return
		end
		local t=insGet(inp,"UserInputType")
		if t~=e.UserInputType.MouseMovement and t~=e.UserInputType.Touch then
			return
		end
		local dx=inp.Position.X-dragStart.X
		local dy=inp.Position.Y-dragStart.Y
		if (not moved) and (dx*dx+dy*dy<25) then
			return
		end
		moved=true
		local cam=insGet(ws,"CurrentCamera")
		local view=cam and cam.ViewportSize or v2(1920,1080)
		topbarBtn.Position=u2(0,clamp(startX+dx,0,view.X-44),0,clamp(startY+dy,0,view.Y-44))
	end)
	local dragEndCon=Connect(insGet(uis,"InputEnded"),function(inp)
		if dragging and isPointer(inp) then
			dragging=false
			if moved then
				DATA.topbar={x=topbarBtn.Position.X.Offset,y=topbarBtn.Position.Y.Offset}
				saveData()
			end
		end
	end)
	topbarBtn.MouseEnter:Connect(function()
		tween(topbarBtn,{BackgroundTransparency=0},0.15)
	end)
	topbarBtn.MouseLeave:Connect(function()
		tween(topbarBtn,{BackgroundTransparency=0.1},0.15)
	end)
	topbarBtn.MouseButton1Click:Connect(function()
		if moved then
			return
		end
		tspawn(openMenu,false)
	end)

	genv.AnimalFEUnload=function()
		alive=false
		pcall(Disconnect,inputCon)
		pcall(Disconnect,topbarCon)
		pcall(Disconnect,dragCon)
		pcall(Disconnect,dragEndCon)
		pcall(saveUsage)
		if menu then
			pcall(menu.kill)
			menu=nil
		end
		pcall(stopAll)
		for _,gui in next,guis do
			pcall(Destroy,gui)
		end
		if genv.AnimalFEUnload then
			genv.AnimalFEUnload=nil
		end
	end

	--the minutes check: the leaderboard of Just A Baseplate counts the minutes played
	tspawn(function()
		local ok,low=pcall(function()
			local ls=lp:FindFirstChild("leaderstats") or lp:WaitForChild("leaderstats",5)
			local minutes=ls and (ls:FindFirstChild("Minutes") or ls:WaitForChild("Minutes",5))
			local value=minutes and tonumber(minutes.Value)
			return (value~=nil) and (value<600)
		end)
		minutesLow=(ok and low==true)
		minutesDone=true
	end)

	preloadMode(modeName)
	--the restricted hats are looked up too, so a worn one can be told apart
	job(function()
		fetchAll(RESTRICTED_LIST,30)
	end)
	tspawn(openMenu,true)
end
main()
