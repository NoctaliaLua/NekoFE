		miscLine("0 - Reanimate",15)
		--a switch that saves DATA[field]
		local toggleRow=function(text,field,onChange)
			local row=miscRow(30)
			mk("TextLabel",{Name=rs(),Size=u2(0,150,1,0),BackgroundTransparency=1,Text=text,Font=e.Font.Gotham,TextSize=15,TextColor3=c3(1,1,1),TextXAlignment=e.TextXAlignment.Left},row)
			local sw=mk("TextButton",{Name=rs(),Position=u2(0,155,0.5,-12),Size=u2(0,46,0,24),BackgroundColor3=rgb(90,90,90),BorderSizePixel=0,AutoButtonColor=false,Text=""},row)
			mk("UICorner",{CornerRadius=UDim.new(1,0)},sw)
			local knob=mk("Frame",{Name=rs(),Position=u2(0,3,0.5,-9),Size=u2(0,18,0,18),BackgroundColor3=c3(1,1,1),BorderSizePixel=0},sw)
			mk("UICorner",{CornerRadius=UDim.new(1,0)},knob)
			local refresh=function(animate)
				local goal={BackgroundColor3=DATA[field] and PINK or rgb(90,90,90)}
				local knobGoal={Position=DATA[field] and u2(1,-21,0.5,-9) or u2(0,3,0.5,-9)}
