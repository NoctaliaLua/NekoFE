local main=function()
	local genv=(getgenv and getgenv()) or _G
	local JUST_A_BASEPLATE=123974602339071 --the hat loader and the "-re" respawn command only work in this place
	local RESPAWN_ON_STOP=true --pressing 0 to stop also respawns your real character (JustABaseplate only)
	local ARM_OUT=0.3 --studs every animation moves the arms away from the torso (WemmbuFE had 0.2, the arms are 0.1 further out here)
	local armIn=0.35-ARM_OUT
	local HIDE_DEPTH=19 --hidden hats sit this many studs below the root part (same as NoctaliaGlitcher)
	local WALK_SPEED=16
	local OWNER_ID=11814716094 --the restricted hats (see RESTRICTED) can only be reanimated by this user and the friends of this user
	local MUSIC_ID="140722099430139" --the menu music
	local FOLDER="NoctaliaNekoFE" --folder in the workspace folder of the executor: settings, keybinds and the stats

	local pi=math.pi
	local rad=math.rad
	local mmax=math.max

	local HATS_WAIT=4.5 --seconds after each -gh command (10 ids each) of the normal modes
	local TR_HATS_WAIT=5 --and of the transitioner modes

	--cuts a list of asset ids into -gh commands of 10 ids each (the ids are separated by commas)
	local gh=function(list)
		local out,cur={},{}
		for id in list:gmatch("%d+") do
			tinsert(cur,id)
			if #cur==10 then
				tinsert(out,table.concat(cur,","))
				cur={}
			end
		end
		if #cur>0 then
			tinsert(out,table.concat(cur,","))
		end
		return out
	end

	--the hats this script moves by itself, everything else you wear just follows the body like it normally would
	--asset ids are strings on purpose, 15 digit numbers turn into 1.2345e+14 when you tostring them
	--bows: pos is where the bow sits on the torso (x right, y up, z backwards, the middle of the torso is 0,0,0), ids = the first one that is worn is used,
	--sphere = if the hat cant be told apart by its asset (the lookup can fail) a worn hat that is a perfect sphere is used,
	--side = which side of the body it is on (-1 left, 1 right), rot = extra turn of the bow on the spot where it sits
	--the universal bows also have: yaw = how far the bow is turned around the up axis (radians), hang = how far above its middle the point is that it swings around,
	--soft = how strong the spring is (1 = normal)
	--faces: only the one picked with 1 to 4 is shown, the others are hidden under the map
	--modes: hats1/hats2 are sent as two -gh commands (10 ids each), hats is one long list that is cut into commands of 10 ids,
	--rig = hats that become a part of the rig (aligned to a body part, their mesh is looked up from the asset when the reanimate starts)
	local BOW_DOWN=0.23 --white and noob mode: the bows sit this much lower than in the neko mode (0.35 minus 0.12 moved back up)...
	local BOW_OUT=0.15 --...and this much further away from the middle
	local BOW_ACC_FWD=0.73--transitioner mode: the bow accessories sit this far in front of the bows
	local LEG_DROP=2 --transitioner mode: how far the leg accessories slide down with the hands (a leg is 2 studs long)

	--the universal rig and bows (transitioner 2 to 5)
	local UNI_TORSO="122144916481304"
	local UNI_LIMB="132367657204737" --a right arm, used 4 times: both arms and both legs
	local UNI_BOW="16613831300"
	local UNI_BOW_ACC="13389369769"
	local UNI_BAND="16930448372" --the middle of the torso and down, shown by K
	local UNI_BAND_ACC="10991697781" --shown by K as well
	local UNI_YAW=rad(30) --the bows face this far outwards (the right one turns -30 degrees on y, the left one 30)
	local UNI_ROLL=rad(10) --and their tops lean this far away from the torso
	local UNI_BOW_DROP=0.22 --the bows (and what hangs on them) sit this much lower again
	local UNI_BAND_UP=0.08 --the band and the band accessory sit this much higher than in transitioner 1
	local UNI_ACC_DROP=0.48 --the bow accessories (in front of the bows) sit this much straight down
	local UNI_BACK=0.4 --the bows and their accessories sit this far further back (towards the torso)...
	local UNI_DOWN=0.1 --...and this much lower than the old bows
	local UNI_HANG=0.35 --how far above the middle of the bow its swing point is (the top of the ugc)
	local UNI_SOFT=0.5 --how strong the bow spring is compared to the old bows
