	--rounded gray button with a lighter stroke (both 70% transparent), a faint hover effect
	local makeButton=function(parent,text,x,y)
		local b=mk("TextButton",{
			Name=rs(),Position=u2(0,x,1,y),Size=u2(0,BTN_W,0,BTN_H),
			BackgroundColor3=rgb(75,75,75),BackgroundTransparency=0.7,BorderSizePixel=0,AutoButtonColor=false,
			Text=text,Font=e.Font.GothamMedium,TextSize=18,TextColor3=c3(1,1,1)
		},parent)
		mk("UICorner",{CornerRadius=UDim.new(0,12)},b)
		local stroke=mk("UIStroke",{Color=rgb(150,150,150),Transparency=0.7,Thickness=1.5,ApplyStrokeMode=e.ApplyStrokeMode.Border},b)
		b.MouseEnter:Connect(function()
			tween(b,{BackgroundTransparency=0.5},0.2)
			tween(stroke,{Transparency=0.5},0.2)
		end)
		b.MouseLeave:Connect(function()
			tween(b,{BackgroundTransparency=0.7},0.2)
			tween(stroke,{Transparency=0.7},0.2)
		end)
		return b,stroke
	end

	--the 8 second counter on a hat button
	local runCooldown=function(b,text,key)
		tspawn(function()
			while alive and (osclock()<(cdUntil[key] or 0)) do
				b.Text=math.ceil(cdUntil[key]-osclock()).."s"
				twait(0.2)
			end
			b.Text=text
		end)
	end

	----------------------------------------------------------------------------
	-- the music and the 30 bars: the music is a normal sound, the bars follow the spectrum of a second (silent) player of the same asset,
	-- if that doesnt work on this client the bars follow the loudness of the sound
	----------------------------------------------------------------------------
	local startMusic=function()
		local objs={}
		local snd=mk("Sound",{Name=rs(),SoundId="rbxassetid://"..MUSIC_ID,Looping=true,Volume=0},SOUND)
		tinsert(objs,snd)
		snd:Play()
		tween(snd,{Volume=0.6},1,e.EasingStyle.Linear)
		local analyzer=nil
		pcall(function()
			local player=mk("AudioPlayer",{Name=rs(),Looping=true},nil)
			tinsert(objs,player)
			pcall(function()
				player.AssetId="rbxassetid://"..MUSIC_ID
			end)
			pcall(function()
				player.Asset=Content.fromUri("rbxassetid://"..MUSIC_ID)
			end)
			local an=mk("AudioAnalyzer",{Name=rs()},nil)
			tinsert(objs,an)
			local wire=mk("Wire",{Name=rs(),SourceInstance=player,TargetInstance=an},nil)
			tinsert(objs,wire)
			player.Parent=SOUND
			an.Parent=SOUND
			wire.Parent=SOUND
			player:Play()
			analyzer=an
		end)
		local peak=0.0001
		local loudPeak=50
		local levels={}
		for k=1,BAR_COUNT do
			levels[k]=0
		end
		local music={}
		--0 to 1 for every bar
		music.levels=function(dt,t)
			local target={}
			local real=nil
			if analyzer then
				local ok,spec=pcall(function()
					return analyzer:GetSpectrum()
				end)
				if ok and type(spec)=="table" and #spec>0 then
					real=spec
				end
			end
			local any=false
			if real then
				local usable=mmax(8,math.floor(#real*0.45)) --the highest bins are empty in most music
				local raw={}
				for k=1,BAR_COUNT do
					local lo=math.floor(usable*((k-1)/BAR_COUNT)^1.8)+1
					local hi=mmax(lo,math.floor(usable*(k/BAR_COUNT)^1.8))
					local sum=0
					for bin=lo,hi do
						sum=sum+(real[bin] or 0)
					end
					local v=sum/(hi-lo+1)
					raw[k]=v
					if v>peak then
						peak=v
					end
					if v>0 then
						any=true
					end
				end
				peak=mmax(0.0001,peak*(1-dt*0.2))
				for k=1,BAR_COUNT do
					target[k]=sqrt(clamp(raw[k]/peak,0,1))
				end
			end
			if not any then
				local loud=snd.PlaybackLoudness
				if loud>loudPeak then
					loudPeak=loud
				end
				loudPeak=mmax(50,loudPeak*(1-dt*0.1))
				local base=clamp(loud/loudPeak,0,1)
				for k=1,BAR_COUNT do
					target[k]=base*(0.35+0.65*abs(sin(t*(1.3+k*0.31)+k*1.7)))*(1-0.4*(k/BAR_COUNT))
				end
			end
			for k=1,BAR_COUNT do
				local cur=levels[k]
				local rate=(target[k]>cur) and 22 or 7
				levels[k]=cur+(target[k]-cur)*min(1,dt*rate)
			end
			return levels
		end
		music.kill=function()
			for _,o in next,objs do
				pcall(Destroy,o)
			end
		end
		--fades out, the menu is gone and the music with it
		music.stop=function()
			tween(snd,{Volume=0},0.5,e.EasingStyle.Linear)
			tdelay(0.6,music.kill)
		end
		return music
	end

	----------------------------------------------------------------------------
	-- the cinematic camera: high above the map, slowly around it, blurred
	----------------------------------------------------------------------------
	local getMapInfo=function()
		local lo,hi=nil,nil
		local add=function(pos,half)
			local a,b=pos-half,pos+half
			if not lo then
				lo,hi=a,b
				return
			end
			lo=v3(min(lo.X,a.X),min(lo.Y,a.Y),min(lo.Z,a.Z))
			hi=v3(mmax(hi.X,b.X),mmax(hi.Y,b.Y),mmax(hi.Z,b.Z))
		end
		for _,child in next,GetChildren(ws) do
			pcall(function()
				if IsA(child,"Terrain") or IsA(child,"Camera") or plrs:GetPlayerFromCharacter(child) then
					return
				end
				if IsA(child,"BasePart") then
					local half=child.Size/2
					add(child.Position,v3(min(half.X,1500),min(half.Y,1500),min(half.Z,1500)))
				elseif IsA(child,"Model") then
					local cfv,size=child:GetBoundingBox()
					local half=size/2
					add(cfv.Position,v3(min(half.X,1500),min(half.Y,1500),min(half.Z,1500)))
				end
			end)
		end
		if not lo then
			return {center=v3_0,radius=100,camY=120}
		end
		local ext=hi-lo
		local radius=clamp(mmax(ext.X,ext.Z)*0.5,60,700)
		return {center=(lo+hi)/2,radius=radius,camY=hi.Y+clamp(radius*0.5,60,300)}
	end
	local orbitCF=function(info,t)
		local a=t*0.06
		local r=info.radius*(0.9+0.1*sin(t*0.07))
		local center=info.center
		local p=v3(center.X+cos(a)*r,info.camY+sin(t*0.11)*10,center.Z+sin(a)*r)
		return cfl(p,center)
	end
	local playerCF=nil
	--where the camera goes back to: the camera of the reanimate while it runs, else behind the player
	local camTarget=function()
		if c and RT and RT.t then
			return RT.t.getCamCF()
		end
		return playerCF()
	end
	--where the normal camera is behind the player
	playerCF=function()
		local ch=insGet(lp,"Character")
		local root=ch and ch:FindFirstChild("HumanoidRootPart")
		if not root then
			return nil
		end
		local look=root.CFrame.LookVector*v3_101
		if vmagnitude(look)<0.01 then
			look=v3(0,0,-1)
		end
		look=vnormalize(look)
		local focus=root.Position+v3(0,1.5,0)
		return cfl(focus-look*12+v3(0,3,0),focus)
	end

