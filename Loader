				n=n+1
				return mk("TextLabel",{Name=rs(),LayoutOrder=n,Size=u2(1,0,0,size+6),BackgroundTransparency=1,Text=text,Font=font or e.Font.Gotham,TextSize=size,TextColor3=color or c3(1,1,1),TextXAlignment=e.TextXAlignment.Left},col)
