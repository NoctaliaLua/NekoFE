			--the picture of a hat that has a SurfaceAppearance instead of a texture id (faces made like that can share one mesh)
			local wornPicture=function(p)
				local sa=FindFirstChildOfClass(p,"SurfaceAppearance")
				return sa and tostring(insGet(sa,"ColorMap")):match("%d+")
			end
			local accessoryName=function(p)
				local acc=insGet(p,"Parent")
				return acc and insGet(acc,"Name")
			end
			local sizeClose=function(p,hsize)
				return (hsize~=nil) and (vmagnitude(insGet(p,"Size")-hsize)<0.05)
			end
			--is the handle a perfect sphere (as wide as tall and deep)
			local isRound=function(p)
				local s=insGet(p,"Size")
				local sm=FindFirstChildOfClass(p,"SpecialMesh")
				if sm then
					s=s*insGet(sm,"Scale")
				end
				local x,y,z=v3Get(s,"X"),v3Get(s,"Y"),v3Get(s,"Z")
				local lo=min(x,y,z)
				return (lo>0) and ((mmax(x,y,z)/lo)<1.08)
			end
			--pass 1: mesh, texture and picture have to match, pass 2: mesh and texture, pass 3: only the mesh
			--a hat without a mesh id: pass 1: accessory name and size, pass 2: the name, pass 3: the size. pass 4: the shape (only pieces with sphere=true)
			local matches=function(part,p,info,pass)
				if info.m~="" then
					return sfind(part.m,info.m) and ((pass==3) or sfind(part.t,info.t)) and ((pass~=1) or (info.sa~=nil and wornPicture(p)==info.sa))
				end
				if part.m~="" then
					return false
				end
				local named=accessoryName(p)==info.name
				if pass==1 then
					return named and sizeClose(p,info.hsize)
				elseif pass==2 then
					return named
				end
				return sizeClose(p,info.hsize)
			end
			local claim=function(key,part,used,pass)
				local j=getPartJoint(part)
				if j and j.Part1 then
					used[part]=true
					part.fx=true --these get the velocity of the body: the engine gives them the velocity of the root part instead of their own
					--the same accessory can be worn twice (both bows, both bow accessories), so every claimed hat is named after its piece in the workspace
					pcall(function()
						local handle=part.p
						local acc=insGet(handle,"Parent")
						if acc and IsA(acc,"Accoutrement") then
							insSet(acc,"Name",key)
						end
						insSet(handle,"Name",key)
					end)
					return {key=key,part=part,joint=j,Part1=j.Part1,C0=j.C0,C1=j.C1,pass=pass}
				end
				return nil
			end
			local findPiece=function(key,used,pass)
				if not PIECES[key] then
					return nil
				end
				if pass==4 then
					if PIECES[key].sphere then
						for part in next,cframes do
							local p=part.p
							if p and part.m and (not used[part]) and IsDescendantOf(p,ws) and isRound(p) then
								local h=claim(key,part,used,pass)
								if h then
									return h
								end
							end
						end
					end
					return nil
				end
				for _,id in next,PIECES[key].ids do
					local info=hatmeshes[id]
					if info then
						for part in next,cframes do
							local p=part.p
							if p and part.m and (not used[part]) and IsDescendantOf(p,ws) and matches(part,p,info,pass) then
								local h=claim(key,part,used,pass)
								if h then
									return h
								end
							end
						end
					end
				end
				return nil
			end
			resolve=function()
				--a hat that fell off (or got taken over by someone else) stays in here: the engine keeps its place and the animation keeps going,
				--it snaps back as soon as the hat is ours again
				local used={}
				for _,h in next,pieces do
					used[h.part]=true
				end
				--exact matches of every piece first, so a face that looks like another one can never take its hat
				for pass=1,4 do
					for _,key in next,PIECE_KEYS do
						if not pieces[key] then
							pieces[key]=findPiece(key,used,pass)
						end
					end
				end
			end
			resolve()
			local hideCF=cf(0,-HIDE_DEPTH,0)

			----------------------------------------------------------------
			-- smoke (transitioner mode: K around the torso and arms, L when the leg accessories go back on the legs, around the legs)
			-- a box of smoke particles (they face the camera and spin a bit) that follows the body part while the smoke is made
			----------------------------------------------------------------
			local SMOKE_TIME=0.35 --seconds the smoke is made
			local SMOKE_LIFE=1 --seconds until the emitter is removed (the last puffs need time to fade out)
			local smokes={}
			local newSmoke=function(size,part,rate)
				local follow=cframes[part]
				if not follow then
					return
				end
				local box=mk("Part",{Name=rs(),Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Transparency=1,Size=size,CFrame=follow},nil)
				local pe=mk("ParticleEmitter",{
					Name=rs(),
					Texture="rbxasset://textures/particles/smoke_main.dds",
					Orientation=e.ParticleOrientation.FacingCamera,
					Shape=e.ParticleEmitterShape.Box,
					ShapeStyle=e.ParticleEmitterShapeStyle.Volume,
					ShapeInOut=e.ParticleEmitterShapeInOut.Outward,
					Rate=rate,
					Lifetime=NumberRange.new(0.4,0.65),
					Speed=NumberRange.new(2,5),
					Drag=2,
					Rotation=NumberRange.new(0,360),
					RotSpeed=NumberRange.new(-200,200),
					Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,2.6)}),
					Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.05),NumberSequenceKeypoint.new(0.7,0.25),NumberSequenceKeypoint.new(1,1)}),
					Color=ColorSequence.new(rgb(240,240,240),rgb(170,170,170)),
					LightEmission=0,
					ZOffset=1,
					LockedToPart=false,
					Enabled=true
				},box)
				insSet(box,"Parent",ws)
				pe:Emit(12)
				tinsert(smokes,{part=part,box=box,pe=pe,t0=osclock()})
			end
			local smokeTorso=function()
				if torsoP then
					newSmoke(v3(4.8,2.8,2),torsoP,160) --wide enough for the arms, deep enough for the front and the back
				end
			end
			local smokeLegs=function()
				for _,leg in next,legPs do
					newSmoke(v3(1.8,2.6,1.8),leg,100)
				end
			end
			local updateSmokes=function()
				local now=osclock()
				for k=#smokes,1,-1 do
					local s=smokes[k]
					local age=now-s.t0
					if age>SMOKE_LIFE then
						pcall(Destroy,s.box)
						table.remove(smokes,k)
					else
						if (age>SMOKE_TIME) and s.pe.Enabled then
							s.pe.Enabled=false
						end
						local follow=cframes[s.part]
						if follow then
							s.box.CFrame=follow
						end
					end
				end
			end
			local clearSmokes=function()
				for _,s in next,smokes do
					pcall(Destroy,s.box)
				end
				tclear(smokes)
			end

			----------------------------------------------------------------
			-- per frame: put the bows on the torso, show the face you picked and hide the others
			----------------------------------------------------------------
			local frame=function()
				if sine>=S.nextResolve then
					S.nextResolve=sine+1
					resolve()
				end
				updateSmokes()
				S.bowW=S.bowW+((S.bowFix and 1 or 0)-S.bowW)*deltaTime
				--the bows react to the body's up and down speed like they hang on a spring: when the body suddenly stops (landing) or starts (jump)
				--they get thrown the other way and swing down, up, down (lower), up (lower)... until they settle
				local dt=min(sine-S.lastT,0.05)
				S.lastT=sine
				S.nSine=S.nSine+S.nChange*30*dt --the old script went up by `change` 30 times per second
				if nekoOn and S.hold and (not S.act) and (not S.inAir) and (not menuUnlock) then --holding the left mouse button keeps the combo going
					nekoCombo()
				end
				local yv=t.getYvel()
				local dv=yv-S.lastYv
				S.lastYv=yv
				if dt>0 then
					for side,b in next,S.bounce do
						b.v=b.v-dv*BOW_BOUNCE
						b.v=b.v+(-b.k*b.o-b.c*b.v)*dt
						b.o=clamp(b.o+b.v*dt,-0.6,0.6)
						b.vx=b.vx-dv*BOW_BOUNCE*0.7*side
						b.vx=b.vx+(-b.kx*b.ox-b.cx*b.vx)*dt
						b.ox=clamp(b.ox+b.vx*dt,-0.25,0.25)
						
					end
				end
				--transitioner mode: the weights that bring pieces up (and take them down). K: bows up and transition hats down. L: the animation runs
				--(only while the L idle animation is called, walking or jumping ends it), the torso band is up in the second half of it
				S.kW=S.changer and 1 or 0 --instant
				if S.transition then
					--plays once on top of whatever emote or walk is running (frame runs after the animations), once it is done it stays done until L is pressed again
					if S.tr<1 then
						S.tr=min(S.tr+dt/TR_TIME,1)
						local p=poses.transition(sine,S.tr)
						--the animation is blended in over the first part and out over the last part, so the change from the normal pose is smooth
						local a=min(trEase(0,0.14,S.tr),1-trEase(0.9,1,S.tr))
						RootJoint.C0=Lerp(RootJoint.C0,p.root,a)
						Neck.C0=Lerp(Neck.C0,p.neck,a)
						RightShoulder.C0=Lerp(RightShoulder.C0,p.rs,a)
						LeftShoulder.C0=Lerp(LeftShoulder.C0,p.ls,a)
						RightHip.C0=Lerp(RightHip.C0,p.rh,a)
						LeftHip.C0=Lerp(LeftHip.C0,p.lh,a)
					end
				else
					S.tr=0
				end
				S.bandW=clamp(S.bandW+((S.transition and S.tr>0.35) and 1 or -1)*dt/0.3,0,1)
				local legDrop=trLegDrop(S.tr)
				for key,h in next,pieces do
					local j=h.joint
					local piece=PIECES[key]
					--how far up the piece is, a piece with a gate is under the map until its key shows it
					local gate=piece.gate
					local vis=1
					if gate=="changer" then
						vis=S.kW
					elseif gate=="band" then
						vis=S.bandW
					elseif gate=="trans" then
						vis=1-S.kW
					elseif gate=="claws" then
						vis=S.claws and 1 or 0
					end
					if vis<=0.001 then
						j.Part1=rootP
						j.C0=cf_0
						j.C1=hideCF
					elseif piece.pos then
						--the hat goes to torso * C1 (C0 is nothing), while the bow fix plays the bow follows the hand a little
						local pos=piece.pos
						local nudge=S.nudge[key]
						local rise=0
						if vis<1 then --coming up from under the map
							rise=(1-vis*vis*(3-2*vis))*HIDE_DEPTH
						end
						local c1=nil
						if piece.side then
							--bows and their accessories: the bow (pivot) bounces up/down and sideways, follows the hand in the bow fix and tilts a little,
							--an accessory (its pos is the pivot plus an offset) is turned around the bow with it
							local b=S.bounce[piece.side]
							local pivot=piece.pivot or pos
							local rel=pos-pivot
							if nudge then
								rel=rel+nudge
							end
							--the universal bows (soft < 1) are calmer, hang from the top of the bow (hang = studs above the bow's middle) and face yaw radians outwards
							local soft=piece.soft or 1
							local hang=piece.hang or 0
							local move=v3(b.ox*soft,b.o*soft-rise,0)
							if S.bowW>0.001 then
								move=move+fixBowOffset(piece.side,sine)*S.bowW
							end
							local bowCF=cfMul(cfMul(cfMul(cf(pivot+move+v3(0,hang,0)),cfMul(angles(0,piece.yaw or 0,0),angles(0,0,piece.roll or 0))),angles(b.o*BOW_TILT_X*soft,0,b.ox*BOW_TILT_Z*soft)),cf(0,-hang,0))
							if piece.flatRel then --the offset is in torso space and is not turned with the bow (down stays down)
								c1=cfMul(cf(pivot+move+rel),cfMul(cfMul(cfMul(cf(0,hang,0),cfMul(angles(0,piece.yaw or 0,0),angles(0,0,piece.roll or 0))),angles(b.o*BOW_TILT_X*soft,0,b.ox*BOW_TILT_Z*soft)),cf(0,-hang,0)))
							else
								c1=cfMul(bowCF,cf(rel))
							end
						else
							if nudge then
								pos=pos+nudge
							end
							c1=cf(pos-v3(0,rise,0))
						end
						j.Part1=torsoP
						j.C0=cf_0
						j.C1=piece.rot and cfMul(c1,piece.rot) or c1
					elseif piece.leg then
						if S.transition and S.tr>=1 then
							--hidden under the root part like the faces (moves with you, so the emotes dont show it)
							j.Part1=rootP
							j.C0=cf_0
							j.C1=hideCF
						else
							--on the leg it belongs to, in the place it has on an arm. the legs stay upright in the L animation, so down is down
							j.Part1=legPs[piece.leg] or h.Part1
							j.C0=h.C0
							--legFlip turns the accessory around the leg, legUp lifts it (some of the universal modes)
							local shift=piece.legShift or v3_0
							j.C1=cfMul(cfMul(cf(v3Get(shift,"X"),-legDrop+(piece.legUp or 0),v3Get(shift,"Z")),ry(piece.legFlip or 0)),h.C1)
						end
					elseif piece.arm then
						--the claws (F): on the arm in the place a normal player would wear them, piece.armIn studs towards the torso and 0.45 studs down
						j.Part1=armPs[piece.arm] or h.Part1
						j.C0=h.C0
						j.C1=cfMul(cfMul(cf(piece.armIn,-0.45,0),ry(pi)),h.C1) --turned 180 degrees around the arm so they sit on the outer side of the hand and face away from the torso
					elseif gate=="trans" then
						--where the accessory normally sits, sinking under the map while K is on
						j.Part1=h.Part1
						j.C0=h.C0
						j.C1=cfMul(cf(0,-(1-vis)*HIDE_DEPTH,0),h.C1)
					elseif key=="tail" then
						--turns around the point the tail is attached at (the waist), so it waves
						j.Part1=h.Part1
						j.C0=h.C0
						j.C1=cfMul(h.C1,ry(TAIL_SWING*sin(sine*TAIL_SPEED)))
					elseif key==S.faceKey then
						--back to where the accessory normally sits
						j.Part1=h.Part1
						j.C0=h.C0
						j.C1=h.C1
					else
						j.Part1=rootP
						j.C0=cf_0
						j.C1=hideCF --like NoctaliaGlitcher: under the root part, moving with you
					end
				end
			end

			----------------------------------------------------------------
			-- keys
			----------------------------------------------------------------
			local FACE_KEY={One=1,Two=2,Three=3,Four=4}
			--with the neko animations the changer is V and the transitioner is C (K and L do nothing), F / Z are the claws and the uppercut
			local changerKey=nekoOn and "V" or "K"
			local transKey=nekoOn and "C" or "L"
			tinsert(cons,Connect(insGet(uis,"InputBegan"),function(inp,processed)
				if insGet(gs,"MenuIsOpen") or GetFocusedTextBox(uis) then
					return
				end
				local name=insGet(inp,"KeyCode").Name
				local face=FACE_KEY[name]
				if face then
					if PIECES["face"..face] then --a mode can have less than 4 faces
						S.face=face
						S.faceKey="face"..face
					end
				elseif name=="Q" and not nekoOn then
					setWalkSpeed(WALK_SPEED)
					t.resetmode()
				elseif name=="R" and not nekoOn then
					--R: click teleport on and off (the click is handled below)
					S.clickTp=not S.clickTp
				elseif nekoOn and name=="F" then
					--F: the claws (they come out of the hands, the click attacks change), you walk faster and jump higher with them. nothing happens while an attack plays
					if not S.act then
						S.claws=not S.claws
						nekoSpeed()
						nk.sound(S.claws and "3051417649" or "3051417791",1.5,0.8)
						nk.notify(S.claws and "Claws: ON" or "Claws: OFF")
					end
				elseif nekoOn and name=="Z" then
					if not S.act then
						nekoAttackZ()
					end
				elseif PIECES.bowAcc1 and name==changerKey then
					--K: the changer, on and off. the bows and their accessories come up, the transition hats go under the map
					S.changer=not S.changer
					smokeTorso()
				elseif PIECES.bowAcc1 and name==transKey then
					--L: the transitioner, on and off (off is instant: the leg accessories are back on the legs and the band is gone)
					S.transition=not S.transition
					S.tr=0
					if not S.transition then
						S.bandW=0
						smokeLegs() --only when the original accessories go back, not when the animation starts
					end
				end
			end))

			--Original Neko: the left mouse button starts the click combo (frame() keeps it going while the button is held)
			if nekoOn then
				tinsert(cons,Connect(insGet(uis,"InputBegan"),function(inp,processed)
					if (not processed) and (insGet(inp,"UserInputType")==e.UserInputType.MouseButton1) then
						S.hold=true
					end
				end))
				tinsert(cons,Connect(insGet(uis,"InputEnded"),function(inp)
					if insGet(inp,"UserInputType")==e.UserInputType.MouseButton1 then
						S.hold=false
					end
				end))
			end

			--click teleport (R): left click puts the root part where the mouse points at (the camera moves with it), clicks on the sky do nothing
			tinsert(cons,Connect(insGet(uis,"InputBegan"),function(inp,processed)
				if processed or (not S.clickTp) or (insGet(inp,"UserInputType")~=e.UserInputType.MouseButton1) then
					return
				end
				local hit,onSurface=t.mouseHit(5000)
				if onSurface then
					t.setCfr(hit+v3_010*3)
				end
			end))

			--Just A Baseplate has a "-net" chat command that helps the hats stay yours (found in game: "/e -net" makes them stay up longer).
			--it is sent right after the joints break, and again whenever a hat gets lost (at most every 5 seconds)
			local netCd=0
			local sendNet=function()
				if osclock()<netCd then
					return
				end
				netCd=osclock()+5
				tspawn(function()
					fireCmd("-net")
				end)
			end
			t.setHooks({frame=frame,onLost=sendNet})
			tdelay(0.3,sendNet)
			setWalkSpeed(WALK_SPEED)
			if nekoOn then
				t.setJumpPower(nk.JUMP_POWER)
			end

			RT={t=t,S=S,cleanup=clearSmokes}
			DATA.stats.reanimations=DATA.stats.reanimations+1
			saveData()
			updateStats()
			notify("Reanimate enabled")
		end)
		starting=false
		if not fine then
			stopAll()
		end
	end

	----------------------------------------------------------------------------
	-- reanimate toggle (the Reanimate button and the 0 key), custom commands and their keybinds
	----------------------------------------------------------------------------
	local toggleReanimate=function()
		if starting then
			return
		end
		if c or RT then
			stopAll()
			notify("Reanimate disabled")
		else
			tspawn(function()
				--the reanimate takes the angle and the distance of its camera from the camera it starts with, so the menu camera (high above the map) goes back to the player first
				if menu and menu.snapCamera and menu.snapCamera() then
					twait(0.3)
				end
				local wasOrbit=menu and menu.snapCamera and menu.snapCamera()
				if wasOrbit then
					twait(0.3)
				end
				startReanimate()
				if wasOrbit and menu and RT then --the menu camera goes on, now on top of the camera of the reanimate
					menu.startCamera()
				end
			end)
		end
	end

	--the command of Just A Baseplate each custom keybind fires
	local CUSTOM={
		{id="reset",label="Reset",cmd="-re"},
		{id="rs",label="Rs",cmd="-rs"},
		{id="pd",label="Permadeath",cmd="-pd"},
		{id="r15",label="R15",cmd="-r15"},
		{id="r6",label="R6",cmd="-r6"},
		{id="sit",label="Sit",cmd="-sit"}
	}
	local runCustom=function(cmd)
		tspawn(fireCmd,cmd.cmd)
		notify(cmd.label.." enabled")
	end
	--keys the script already uses, they cant be a custom keybind
	local RESERVED={}
	for _,n in next,{"Zero","One","Two","Three","Four","Z","X","C","B","N","M","T","Y","U","R","Q","K","L","W","A","S","D","Space","LeftShift","RightShift","RightControl"} do
		RESERVED[n]=true
	end
	local openMenu=nil --defined in the menu part below
	local capture=nil --{cmd=,btn=} while a keybind button waits for a key
	local bindText=function(id)
		return DATA.binds[id] or "Set Keybind"
	end
	local inputCon=Connect(insGet(uis,"InputBegan"),function(inp)
		if insGet(inp,"UserInputType")~=e.UserInputType.Keyboard then
			return
		end
		local key=insGet(inp,"KeyCode").Name
		if capture then
			local cap=capture
			capture=nil
			if key=="Backspace" or key=="Escape" then --removes the bind
				DATA.binds[cap.cmd.id]=nil
				saveData()
			else
				local taken=RESERVED[key] or (DATA.originalNeko and (key=="F" or key=="V")) --F and V are used by the neko animations
				for _,other in next,CUSTOM do
					if other.id~=cap.cmd.id and DATA.binds[other.id]==key then
						taken=true
					end
				end
				if taken then
					notify(key.." is already used")
				else
					DATA.binds[cap.cmd.id]=key
					saveData()
				end
			end
			cap.btn.Text=bindText(cap.cmd.id)
			return
		end
		if insGet(gs,"MenuIsOpen") or GetFocusedTextBox(uis) then
			return
		end
		if key=="Zero" then
			toggleReanimate()
			return
		end
		if key=="RightControl" then --opens the menu, closes it again when it is open
			if menu then
				tspawn(menu.close)
			else
				tspawn(openMenu,false)
			end
			return
		end
		for _,cmd in next,CUSTOM do
			if DATA.binds[cmd.id]==key then
				runCustom(cmd)
			end
		end
	end)

	----------------------------------------------------------------------------
	-- menu: black screen, cinematic camera, music with a visualizer, buttons
	----------------------------------------------------------------------------
	local BTN_W,BTN_H,BTN_GAP=200,44,10
	local MENU_X=100 --the buttons are 100 pixels from the left side of the screen...
	--...and the first one starts 500 pixels above the bottom, on mobile 256 (the last one ends 50 pixels above it)
	local MENU_Y=(insGet(uis,"TouchEnabled") and not insGet(uis,"KeyboardEnabled")) and -256 or -500
	local PANEL_X=MENU_X+BTN_W+30
	local BAR_COUNT=30
	local BAR_MAX=170 --pixels, how tall a bar gets
	local COOLDOWN=8 --seconds a hat button is blocked after it was pressed
